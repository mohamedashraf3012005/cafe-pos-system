name: cash_cafe
description: "A production-level Flutter Desktop POS system."
publish_to: 'none'

version: 1.0.0+1

environment:
  sdk: ^3.6.0

dependencies:
  flutter:
    sdk: flutter
  flutter_localizations:
    sdk: flutter

  # UI & Essentials
  cupertino_icons: ^1.0.8
  window_manager: ^0.4.3
  intl: 0.20.2
  google_fonts: ^6.2.1
  flutter_svg: ^2.0.10

  # State & DI
  flutter_bloc: ^8.1.6
  get_it: ^7.7.0
  equatable: ^2.0.5
  dartz: ^0.10.1

  # Local DB
  drift: ^2.24.2
  sqlite3: ^2.4.6
  drift_flutter: ^0.2.1
  sqlite3_flutter_libs: ^0.5.24

  # Utils
  path_provider: ^2.1.5
  path: ^1.9.0

  # Printing
  printing: ^5.13.3
  pdf: ^3.11.1
  
  # Local license storage
  shared_preferences: ^2.3.2

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^5.0.0
  build_runner: ^2.4.13
  drift_dev: ^2.24.2

flutter:
  uses-material-design: true
